<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="@dimen/dp_4">

    <LinearLayout
        android:id="@+id/tools_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/icon_plus"
            android:layout_width="@dimen/dp_32"
            android:layout_height="@dimen/dp_32"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="@dimen/dp_8"
            android:src="@drawable/icon_plus"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <HorizontalScrollView
            android:id="@+id/scroll_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/image_preview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:clipChildren="true"
                android:orientation="horizontal"
                android:layout_marginEnd="@dimen/dp_15"/>
        </HorizontalScrollView>
    </LinearLayout>

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/icon_text_button"
        android:layout_width="@dimen/dp_56"
        android:layout_height="@dimen/dp_48"
        android:layout_marginTop="@dimen/dp_6"
        android:paddingEnd="@dimen/dp_8"
        android:src="@drawable/icon_text_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tools_layout"
        app:layout_goneMarginTop="@dimen/dp_0"
        tools:ignore="RtlSymmetry" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/chat_bar_audio_text"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_48"
        android:background="@drawable/chat_bar_audio_text_bg"
        android:gravity="center"
        android:text="@string/hold_to_talk"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_14"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@id/icon_text_button"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@id/icon_text_button" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/chat_bar_audio_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="visible"
        app:constraint_referenced_ids="chat_bar_audio_text,icon_text_button" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/text_input_layout"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_48"
        android:layout_marginTop="@dimen/dp_6"
        android:gravity="center_vertical"
        android:padding="@dimen/dp_0"
        app:boxBackgroundMode="none"
        app:endIconDrawable="@drawable/icon_send"
        app:endIconMode="custom"
        app:endIconTint="@null"
        app:hintEnabled="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/icon_voice_button"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tools_layout"
        app:layout_goneMarginTop="@dimen/dp_0">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/chat_bar_edit_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/dp_0"
            android:background="@drawable/chat_bar_edit_bg"
            android:gravity="center_vertical"
            android:hint="@string/text_hint"
            android:includeFontPadding="false"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="4"
            android:minLines="1"
            android:paddingStart="@dimen/dp_10"
            android:paddingTop="@dimen/dp_0"
            android:paddingEnd="@dimen/dp_10"
            android:paddingBottom="@dimen/dp_0"
            android:textColor="@color/input_edit_bg_color"
            android:textColorHint="@color/ai_tool_title"
            android:textCursorDrawable="@drawable/custom_cursor"
            android:textSize="@dimen/sp_14"
            android:visibility="visible"
            tools:ignore="RtlSymmetry" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/icon_voice_button"
        android:layout_width="@dimen/dp_56"
        android:layout_height="@dimen/dp_48"
        android:paddingStart="@dimen/dp_8"
        android:src="@drawable/icon_voice_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/text_input_layout"
        tools:ignore="RtlSymmetry" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/chat_bar_text_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:constraint_referenced_ids="icon_voice_button,text_input_layout"
        app:layout_constraintTop_toBottomOf="@+id/tools_layout" />

    <com.welo.widget.WaveformView
        android:id="@+id/waveFormView"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_48"
        android:background="@drawable/chat_bar_audio_text_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tools_layout"
        android:layout_marginTop="@dimen/dp_6"
        app:layout_goneMarginTop="@dimen/dp_0"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>