<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="@dimen/dp_8"
    android:paddingTop="@dimen/dp_8"
    android:background="@drawable/item_ai_bg">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ai_tool_icon"
        android:layout_width="@dimen/dp_32"
        android:layout_height="@dimen/dp_32"
        android:layout_marginStart="@dimen/dp_11"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/CircleImageView" />

    <TextView
        android:id="@+id/ai_tool_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_8"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_12"
        app:layout_constraintLeft_toRightOf="@+id/ai_tool_icon"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/ai_tool_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_4"
        android:textColor="@color/ai_tool_title"
        android:textSize="@dimen/sp_10"
        app:layout_constraintLeft_toLeftOf="@id/ai_tool_title"
        app:layout_constraintTop_toBottomOf="@id/ai_tool_title" />


</androidx.constraintlayout.widget.ConstraintLayout>