<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#141414"
    android:padding="24dp"
    tools:ignore="NamespaceTypo">



    <!-- 左上角小图标 -->
    <ImageView
        android:id="@+id/iv_scale_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_alignParentTop="true"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:src="@drawable/byte_scale"
         />

    <!-- 中央通话指示区域 -->
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/main_icon"
        android:layout_width="@dimen/dp_180"
        android:layout_height="@dimen/dp_180"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"/>
    <!-- 底部提示文字 -->
    <TextView
        android:id="@+id/tv_bottom_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/bottom_button_container"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="16dp"
        android:text="通话已打开，告诉我你的想法"
        android:textColor="#CCCCCC"
        android:textSize="14sp"/>

    <!-- 底部按钮容器 -->
    <LinearLayout
        android:id="@+id/bottom_button_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="24dp"

        android:gravity="center_horizontal|center_vertical">

        <!-- 取消通话按钮 -->
        <LinearLayout
            android:id="@+id/btn_end_call"
            android:layout_width="95dp"
            android:layout_height="85dp"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_margin="8dp">
            <FrameLayout
                android:layout_width="wrap_content"
                android:gravity="center"
                android:layout_height="wrap_content">
            <View
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/byte_cancel_bg"/>

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:src="@drawable/byte_cancel"
                />
            </FrameLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center"
                android:text="取消通话"
                android:layout_marginTop="8dp"
                android:textColor="#FFFFFF"
                android:textSize="12sp"/>

        </LinearLayout>

        <!-- 麦克风按钮 -->

        <LinearLayout
            android:id="@+id/btn_microphone"
            android:layout_width="95dp"
            android:layout_height="85dp"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_margin="8dp">
            <FrameLayout
                android:layout_width="wrap_content"
                android:gravity="center"
                android:layout_height="wrap_content">
                <View
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/byte_mic_bg"/>

                <ImageView
                    android:id="@+id/iv_mic"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:src="@drawable/byte_mic_on"
                    />
            </FrameLayout>
            <TextView
                android:id="@+id/tv_mic_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center"
                android:text="麦克风已开"
                android:layout_marginTop="8dp"
                android:textColor="#FFFFFF"
                android:textSize="12sp"/>

        </LinearLayout>


        <!-- 扬声器按钮 -->
        <LinearLayout
            android:id="@+id/btn_speaker"
            android:layout_width="95dp"
            android:layout_height="85dp"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_margin="8dp">
            <FrameLayout
                android:layout_width="wrap_content"
                android:gravity="center"
                android:layout_height="wrap_content">
                <View
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/byte_speakerbg"/>

                <ImageView
                    android:id="@+id/iv_speaker"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:src="@drawable/byte_speaker_on"
                    />
            </FrameLayout>
            <TextView
                android:id="@+id/tv_speaker_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center"
                android:text="扬声器已开"
                android:layout_marginTop="8dp"
                android:textColor="#FFFFFF"
                android:textSize="12sp"/>

        </LinearLayout>
    </LinearLayout>

</RelativeLayout>