<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp">

    <!-- 用户消息布局 -->
    <LinearLayout
        android:id="@+id/user_message_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <HorizontalScrollView
            android:id="@+id/user_message_image_scroll"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_64"
            android:layout_marginStart="@dimen/dp_12"
            android:layout_marginEnd="@dimen/dp_8"
            android:visibility="gone"
            tools:ignore="RtlSymmetry">

            <LinearLayout
                android:id="@+id/user_message_image_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/dp_8" />
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical"
            android:paddingStart="@dimen/dp_32"
            android:visibility="visible"
            tools:ignore="RtlSymmetry">
            <!-- 图片消息内容 -->

            <!-- 文本消息内容 -->
            <TextView
                android:id="@+id/user_message_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/out_put_background"
                android:padding="12dp"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_14"
                android:visibility="visible"
                tools:text="这是用户消息内容这是用户消息内容这是用户消息" />

            <TextView
                android:id="@+id/user_message_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/gray_500"
                android:textSize="@dimen/sp_10"
                tools:text="12:30" />

            <ProgressBar
                android:id="@+id/user_message_progress"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/user_message_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/colorPrimary"
                android:textSize="@dimen/sp_10"
                android:visibility="gone"
                tools:text="发送失败" />
        </LinearLayout>

        <ImageView
            android:id="@+id/user_avatar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_user_avatar"
            android:visibility="gone" />
    </LinearLayout>

    <!-- AI消息布局 -->
    <LinearLayout
        android:id="@+id/ai_message_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ai_avatar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_ai_avatar"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:orientation="vertical"
            android:paddingEnd="@dimen/dp_32"
            tools:ignore="RtlSymmetry">

            <!-- 文本消息内容 -->
            <TextView
                android:id="@+id/ai_message_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:autoLink="web"
                android:background="@drawable/out_put_background"
                android:linksClickable="true"
                android:padding="12dp"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:visibility="gone"
                tools:text="这是AI回复内容" />

            <!-- 图片消息内容 -->
            <LinearLayout
                android:id="@+id/ai_message_image_container"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_marginBottom="4dp"
                android:orientation="horizontal"
                android:visibility="gone"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp" />

            <LinearLayout
                android:id="@+id/ai_typing_indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <ProgressBar
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="AI正在思考..."
                    android:textColor="@color/gray_500"
                    android:textSize="@dimen/sp_10" />
            </LinearLayout>

            <TextView
                android:id="@+id/ai_message_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/gray_500"
                android:textSize="@dimen/sp_10"
                tools:text="12:30" />

            <TextView
                android:id="@+id/ai_message_error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/colorPrimary"
                android:textSize="@dimen/sp_10"
                android:visibility="gone"
                tools:text="回复失败，点击重试" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>